# API (Laravel) — must end with /api
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Optional: backend origin if different from API host (defaults from VITE_API_BASE_URL)
# VITE_BACKEND_URL=http://127.0.0.1:8000

# Optional: storage URL (defaults to {BACKEND}/storage)
# VITE_STORAGE_URL=http://127.0.0.1:8000/storage

# Laravel Reverb (realtime)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
